{
  "name": "dsh-gallery",
  "version": "0.1.0",
  "description": "DSH 插件：把本地图片文件夹当成图库来翻——缩略图墙、喜好、垃圾桶、R18 过滤、多图翻页、缩放拖动看图",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "gallery",
    "image",
    "viewer"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2",
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
